#!/usr/bin/env sh

# Courtesy of <https://unix.stackexchange.com/a/4973>

path_add() {

  position=end

  case ${1-} in
  start)
    position=start
    shift
    ;;
  end)
    shift
    ;;
  esac

  for directory; do

    # Canonicalise symbolic links
    directory=$({ cd -- "$directory" && { pwd -P || pwd; }; } 2> /dev/null)

    if [ -z "$directory" ]; then
      continue
    fi

    case ":$PATH:" in
    *":$directory:"*) : ;;
    *)
      case $position in
      start) PATH=$directory${PATH:+:$PATH} ;;
      end) PATH=${PATH:+$PATH:}$directory ;;
      esac
      ;;
    esac

  done

}

path_remove() {

  for directory; do

    directory=$({ cd -- "$directory" && { pwd -P || pwd; }; } 2> /dev/null)

    if [ -z "$directory" ]; then
      continue
    fi

    PATH=$(
      printf '%s' "${PATH-}" |
        awk -v directory="$directory" '
          BEGIN { RS = ":"; ORS = "" }
          $0 != directory {
            if (printed++) printf ":"
            printf "%s", $0
          }
        '
    )

  done

}
