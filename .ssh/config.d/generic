Host github.com
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_rsa_yubikey.pub
  # Keep connection with GitHub open (to prevent constant interaction with the
  # YubiKey) – integrity is ensured by signing commits (which also requires
  # interaction with the YubiKey)
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 1h

Host codeberg.org
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_rsa_yubikey.pub

Host hf.co
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_rsa_yubikey.pub

Host *.eu-central-1.compute.amazonaws.com
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_rsa_yubikey.pub

# Firecracker / local VMs
Host 172.16.*.*
  PubkeyAuthentication yes
