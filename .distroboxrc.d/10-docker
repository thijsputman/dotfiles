#!/usr/bin/env bash

if ! command -v docker &> /dev/null; then

  export DOCKER_HOST=unix:///run/user/1000/docker.sock

  function docker() {
    if (($# >= 1)) && [[ $1 == "compose" ]] && command -v docker-compose &> /dev/null; then
      shift
      command docker-compose "$@"
    else
      distrobox-host-exec --yes docker "$@"
    fi
  }

  export -f docker

fi
