#!/usr/bin/env bash

: "${GOPATH:="$HOME/.local/go"}"
export GOPATH

if ! [[ $PATH =~ (^|:)"$GOPATH/bin"(:|$) ]]; then
  echo "⚠️ Add \"📂 $GOPATH/bin\" to PATH... " >&3
  PATH="$PATH:$GOPATH/bin"
fi

echo "🐹 shfmt" >&3
go install mvdan.cc/sh/v3/cmd/shfmt@v3.12.0

echo "🐹 actionlint" >&3
go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.3
