#!/usr/bin/env bash

set -euo pipefail

arch=$(dpkg --print-architecture)
base=https://github.com/caddyserver/caddy/releases/download
: "${version:=2.11.4}"

wget -nv \
  "${base}/v${version}/caddy_${version}_linux_${arch}.deb"

dpkg --fsys-tarfile "caddy_${version}_linux_${arch}.deb" |
  tar -xO ./usr/bin/caddy > caddy
chmod +x caddy
mv -f caddy ~/.local/bin

command -v caddy &&
  echo "⚙️ Installed $(caddy --version)" >&3
